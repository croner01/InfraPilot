{
  "name": "infrapilot-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && npm run copy:drawio-script",
    "copy:drawio-script": "cp -r src/skills/drawio/scripts dist/skills/drawio/",
    "start": "node dist/index.js",
    "seed": "tsx scripts/seedKnowledge.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp-server": "MCP_SERVER_MODE=true tsx src/index.ts",
    "mcp-server:prod": "MCP_SERVER_MODE=true node dist/index.js"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.1",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@kubernetes/client-node": "^1.4.0",
    "@opensearch-project/opensearch": "^3.6.0",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "openai": "^4.68.0",
    "puppeteer-core": "^24.43.1",
    "ssh2": "^1.17.0",
    "uuid": "^9.0.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.16.5",
    "@types/ssh2": "^1.15.5",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.12",
    "grpc-tools": "^1.13.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  }
}
